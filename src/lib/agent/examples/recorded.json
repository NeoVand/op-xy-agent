[
	{
		"id": "shift-m1",
		"title": "what shift + M1 does",
		"about": "an answer from the manual, shown on the replica",
		"model": "recorded",
		"turns": [
			{
				"user": "what does shift + M1 do?",
				"conductor": [
					{
						"tools": [
							{
								"id": "toolu_01CiudPxVNEWb7X7hJKkHriq",
								"name": "show_on_replica",
								"input": {
									"keys": "shift + M1",
									"caption": "Opens the preset browser for the selected track"
								}
							}
						]
					},
					{
						"tools": [],
						"text": "In instrument mode, `shift + M1` opens the preset browser for the selected track. On OS 1.1.33 it's also how you change a track's engine. The browser opens on the track's current preset, with the engines in the middle and that engine's presets on the right.\n\nTo load a sound, turn `E1` to pick an engine, turn `E2` to pick a preset, then click `E2` to load it. Loading replaces the track's whole sound, including the envelopes, filter and LFO. If you're changing engine, choose it first and shape the other pages afterwards.\n\nIn other modes `shift + M1` does something else. In arrange it clones the current scene, and in song mode it clears the song order.\n\n[instrument.preset-browser] [instrument.engine] [arrange.scenes]"
					}
				],
				"subagent": []
			}
		]
	},
	{
		"id": "walkthrough",
		"title": "walk me to the cutoff",
		"about": "lit steps to follow on the replica",
		"model": "recorded",
		"turns": [
			{
				"user": "walk me through setting the filter cutoff on track 3",
				"conductor": [
					{
						"tools": [
							{
								"id": "toolu_01Dhu3PmPV68ybhorHqoDvJM",
								"name": "plan_steps",
								"input": {
									"show": false,
									"guide": true,
									"track": 3,
									"param": "cutoff"
								}
							}
						]
					},
					{
						"tools": [],
						"text": "Follow the lit keys on the replica:\n\n1. Press `T3` to select track 3.\n2. Press `M3` to open the filter page. It shows the svf filter with cutoff at 00.\n3. Turn `E1` clockwise to raise the cutoff. Higher values open the filter and make the sound brighter.\n\nIf `M3` shows an \"off\" box, the filter is switched off. Press `M3` again to switch it on.\n\n[instrument.filter]"
					}
				],
				"subagent": []
			}
		]
	},
